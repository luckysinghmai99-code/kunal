# ---- Copy this file to .env and fill in real values. Never commit .env. ----

# Server
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Set to 1 when serving over HTTPS so session cookies are marked Secure
COOKIE_SECURE=0

# Storage (JSON document store; see README for the production database path)
DATA_DIR=data

# Accounts with the admin role (comma separated)
ADMIN_EMAILS=admin@example.com

# Currency for token packages
CURRENCY=INR

# ---- Razorpay (get these from your Razorpay dashboard) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Optional LLM refinement for Engine 01 (leave empty to use the built-in engine) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- Optional deployment provider for "Publish" (not connected in this build) ----
DEPLOY_PROVIDER=
DEPLOY_PROVIDER_TOKEN=
